# ==========================================
# Django Application Settings
# ==========================================
DEBUG=True
SECRET_KEY=django-insecure-your-secret-key-for-development
CLIENT_ID=mull
CLIENT_SECRET=your_client_secret
AUTH_JWKS_URL=http://localhost:8000/.well-known/jwks.json

# ==========================================
# Primary Database Settings (PostgreSQL)
# ==========================================
DB_NAME=your_db
DB_USER=your_user
DB_PASSWORD=your_password
DB_HOST=postgres
DB_PORT=5432

# ==========================================
# Redis & Celery Settings
# ==========================================
REDIS_HOST=your_redis_host
CACHE_REDIS_URI=redis://redis:6379/1
CELERY_BROKER=redis://redis:6379/0
CELERY_BACKEND=redis://redis:6379/0

# ==========================================
# OpenSearch / Vector Engine Settings
# ==========================================
OPENSEARCH_HOSTS=http://opensearch:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=your_strong_admin_password_123!
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false

# Connection Pool & Performance Settings
OPENSEARCH_MAX_CONNECTIONS=20
OPENSEARCH_TIMEOUT=30
OPENSEARCH_MAX_RETRIES=3
